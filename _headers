# Заголовки безопасности для всех страниц (Cloudflare Pages).
# CSP: код только из файлов сайта (встроенные скрипты запрещены) и плееров YouTube/Spotify, запросы только к своему API и поиску iTunes,
# сайт нельзя встроить в чужую страницу (защита от подмены кликов).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://open.spotify.com https://*.spotifycdn.com https://*.scdn.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://itunes.apple.com https://*.mzstatic.com https://images.genius.com https://assets.genius.com https://t2.genius.com https://images.rapgenius.com https://cdn-images.dzcdn.net https://e-cdns-images.dzcdn.net; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

/api/*
  Cache-Control: no-store
